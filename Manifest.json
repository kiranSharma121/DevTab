 {
  "manifest_version": 3,
  "name": "DevTab",
  "version": "1.0.0",
  "description": "A productivity dashboard built for developers.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://hackatime.hackclub.com/*"
  ],
  "action": {
    "default_title": "DevTab"
  }
}