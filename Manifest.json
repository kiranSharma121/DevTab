{
  "manifest_version": 3,
  "name": "DevTab",
  "version": "1.1.0",
  "description": "A productivity dashboard built for developers.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://hackatime.hackclub.com/*"
  ],
  "action": {
    "default_title": "DevTab"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@devtab-kiran",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo"
        ]
      }
    }
  }
}